{
  "expo": {
    "name": "MatchPoint",
    "slug": "matchpoint",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.matchpoint.scorekeeper",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSLocalNetworkUsageDescription": "MatchPoint uses the local network to show the score on a second phone and to line up video from extra cameras. Nothing leaves your devices.",
        "NSBonjourServices": [
          "_matchpoint-mp._tcp",
          "_matchpoint-mp._udp"
        ]
      }
    },
    "android": {
      "package": "com.matchpoint.scorekeeper",
      "adaptiveIcon": {
        "backgroundColor": "#0D1117",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.WRITE_SETTINGS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-audio",
        {
          "recordAudioAndroid": false
        }
      ],
      "expo-brightness",
      "expo-screen-orientation",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "backgroundColor": "#0D1117",
          "imageWidth": 180
        }
      ],
      "expo-asset",
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "5792bdee-23ca-4fb6-b656-c2f0f1b2eaaf"
      }
    },
    "owner": "iraklidzadzamia"
  }
}
